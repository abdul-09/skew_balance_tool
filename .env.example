# Copy to .env and fill in as needed: `cp .env.example .env`
#
# Neither variable is required to develop skewproof or run its default test
# suite - the Postgres and Redis integration tests are skipped automatically
# when their variable is unset (see tests/test_sql_source.py and
# tests/test_redis_store.py). They only matter if you want those specific
# tests to run against real services.
#
# Bring the services up first:
#   docker compose -f deploy/docker-compose.yml up -d

# Postgres DSN for the integration tests in tests/test_sql_source.py.
# Matches deploy/docker-compose.yml's postgres service as-is.
SKEWPROOF_PG_DSN=postgresql://skewproof:skewproof@localhost:5432/skewproof

# Redis URL for the integration tests in tests/test_redis_store.py.
# Matches deploy/docker-compose.yml's redis service as-is.
SKEWPROOF_REDIS_URL=redis://localhost:6379/0
